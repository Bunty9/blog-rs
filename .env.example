# blog-rs deployment config. Copy to `.env`, fill in, then `chmod 600 .env`.
# `.env` is gitignored — never commit real secrets.

# ---- App (BLOG_RS__ figment prefix) ----------------------------------------
# 32-byte URL-safe-base64 secret. Generate once:
#   head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '='
BLOG_RS__SIGNING_KEY=
# First-boot admin seed (ignored once the users table is populated).
BLOG_RS__ADMIN_BOOTSTRAP__EMAIL=admin@bunty9.com
BLOG_RS__ADMIN_BOOTSTRAP__PASSWORD=change-me-now
# Port the app listens on inside the container (entrypoint sets BLOG_RS__BIND).
PORT=8080

# ---- Site / mail (separate BLOG_* vars, not the figment prefix) -------------
BLOG_BASE_URL=https://blog.bunty9.com
BLOG_TITLE=blog-rs
BLOG_DESCRIPTION=Engineering notes on systems, performance, and the craft of building software.
# `test` writes mail to ./test-mailbox.eml inside the container. For real mail,
# unset BLOG_RS_MAIL and set the SMTP vars below.
BLOG_RS_MAIL=test
# BLOG_SMTP_HOST=
# BLOG_SMTP_PORT=587
# BLOG_SMTP_USERNAME=
# BLOG_SMTP_PASSWORD=
# BLOG_SMTP_FROM=blog@bunty9.com

# ---- Cloudflare Tunnel ------------------------------------------------------
# Connector token for the dedicated "blog-rs" tunnel (Zero-Trust dashboard).
TUNNEL_TOKEN=

# ---- Litestream -> Cloudflare R2 backups ------------------------------------
# Leave blank to run without backups (e.g. local testing).
LITESTREAM_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
LITESTREAM_BUCKET=blog-rs-backups
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
